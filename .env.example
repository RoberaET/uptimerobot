# UptimeRobot API key (Read-only key is recommended)
UPTIMEROBOT_API_KEY=ur123456-xxxxxxxxxxxxxxxx

# Telegram Bot Token (from BotFather)
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Chat ID for your Developer Group
# (To get this, add the bot to the group and send a test message, then check https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=-1001234567890

# Polling Interval in seconds (e.g., 60 seconds)
POLLING_INTERVAL=60
